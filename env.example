# Template only — copy to `.env` (gitignored) and fill in your values:
#   cp env.example .env
#
# `.env` is never committed; this file uses placeholders only.

# --- Browser (Selenium) ---
# Chromium-based browser: Chrome, Chromium, Brave, …
CHROME_BIN=/path/to/your/browser

# true = no window, false = show browser (--no-headless overrides)
JOBS_HEADLESS=true

# --- Job filters ---
# Comma-separated; title must match at least one include word (OR)
JOBS_INCLUDE=keyword1,keyword2

# Comma-separated; skip titles containing any of these words
JOBS_EXCLUDE=exclude1,exclude2

# Category id from jobs.ge (select name=cid). Empty = interactive prompt.
JOBS_CATEGORY_ID=

# --- Output ---
# Format: csv | json — file is jobs_list_<timestamp>.<ext> in project root
JOBS_OUTPUT_FORMAT=csv
# true = visit each job page and save description (slower)
JOBS_FETCH_DETAILS=false

# --- Logging ---
JOBS_VERBOSE=false

# --- Optional: override listing URL (default: https://jobs.ge/ge/ads/) ---
# JOBS_BASE_URL=https://jobs.ge/ge/ads/
